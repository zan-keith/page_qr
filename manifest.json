{
  "manifest_version": 3,
  "name": "Page Qr",
  "version": "1.0",
  "description": "A simple Chrome extension with HTML and CSS",
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "./assets/icons/icon.png",
        "48": "./assets/icons/icon.png",
        "128": "./assets/icons/icon.png"
    }
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "icons": {
    "16": "assets/icons/icon.png",
    "48": "assets/icons/icon.png",
    "128": "assets/icons/icon.png"
  }
}
